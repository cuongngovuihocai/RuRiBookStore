# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL of your Supabase project (e.g. https://xxxxx.supabase.co)
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-side secret key from Supabase Project Settings -> API.
# Never expose this key to the browser or prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# SUPABASE_BUCKET: Public Storage bucket name in Supabase (default: audiobooks)
SUPABASE_BUCKET="audiobooks"

# ADMIN_EMAIL: Authorized admin Google account email
ADMIN_EMAIL="cuongngovuihocai@gmail.com"

